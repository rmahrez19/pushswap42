/*   Updated: 2024/11/18 16:33:21 by ramahrez         ###   ########.fr       */
/*                                                                            */
/* ************************************************************************** */

#include "libft.h"

t_list	*ft_lstmap(t_list *lst, void *(*f)(void *), void (*del)(void *))
{
	t_list	*new_lst;
	t_list	*nex_ele;
	void	*content;

	if (!lst || !f | !del)
		return (NULL);
	new_lst = NULL;
	while (lst)
	{
		content = f(lst->content);
		nex_ele = ft_lstnew(content);
		if (!nex_ele)
		{
			ft_lstclear(&new_lst, del);
			del(content);
			return (NULL);
		}
		ft_lstadd_back(&new_lst, nex_ele);
		lst = lst->next;
	}			
	return (new_lst);
}
