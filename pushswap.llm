#include "../includes/push_swap.h"

void	print_error(char *str)
{
	ft_free();
	printf(RED "%s\n" RESET, str);
	exit(0);
}

void	ft_check_signe(char **argv)
{
	int	i;
	int	j;
	int	flag;

	j = 1;
	flag = 0;
	while (argv[j])
	{
		i = 0;
		while (argv[j][i])
		{
			if (argv[j][i] != ' ' && flag == 0)
			{
				flag = 1;
				if (argv[j][i] == '-' || argv[j][i] == '+')
					i++;
			}
			if (argv[j][i] == ' ')
				flag = 0;
			if (flag == 1 && (argv[j][i] == '-' || argv[j][i] == '+'))
				print_error("arg invalid");
			i++;
		}
		j++;
	}
}

void	ft_check_num(char **argv)
{
	int	i;
	int	j;

	j = 1;
	i = 0;
	while (argv[j])
	{
		while (argv[j][i])
		{
			if (!((argv[j][i] >= '0' && argv[j][i] <= '9') || argv[j][i] == ' '
					|| argv[j][i] == '+' || argv[j][i] == '-'))
				print_error("ERROR ARGUMENT INVALID");
			i++;
		}
		i = 0;
		j++;
	}
}

void	ft_check_value(char **argv)
{
	int	i;
	int	j;
	int	count;

	i = 0;
	j = 1;
	count = 0;
	while (argv[j])
	{
		while (argv[j][i])
		{
			if (argv[j][i] >= '0' && argv[j][i] <= '9')
				count++;
			else
			{
				if (count >= 12)
					print_error("NUMBER TOO BIG OR TOO SMALL");
				else
					count = 0;
			}
			i++;
		}
		i = 0;
		j++;
	if (count >= 12)
		print_error("number too big or too small");
	count = 0;
	}
}

void	ft_check_error(char **argv)
{
	ft_check_num(argv);
	ft_check_value(argv);
	ft_check_signe(argv);
}
