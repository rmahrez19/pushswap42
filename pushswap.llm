int ft_check_double(t_stack **stack, int n)
{
    t_stack *current;

    if(!*stack || !(*stack)->next)
        return (0);
    current = *stack;
    while(1)
    {
        if(n == current->content)
            return (1);
        current = current->next;
        if(current == *stack)
            break ;
    }
    return (0);
}
